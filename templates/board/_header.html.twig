<header class="topbar">
    <div class="brand">
        <a
            class="secondary-button home-button"
            href="{{ path(home_route|default('app_home')) }}"
            title="{{ 'board.back_home'|trans }}"
            aria-label="{{ 'board.back_home'|trans }}"
        >
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 10.5 12 4l8 6.5" />
                <path d="M6 9.5V19a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9.5" />
            </svg>
        </a>
        <img
            id="board-icon"
            class="brand-mark"
            src="{{ current_board_icon_url|default(asset('images/favicon.png')) }}"
            alt=""
            aria-hidden="true"
        >
        <div class="board-identity">
            {% if boards|default([])|length %}
                <div class="board-switcher-field">
                    <label class="sr-only" for="board-switcher-native">
                        {{ 'board.switch_board'|trans }}
                    </label>
                    {# Gabarit rendu côté serveur : le script le remplace
                       par la liste déroulante, sans clignotement. #}
                    <div
                        id="board-switcher"
                        class="filter-multiselect board-switcher is-single"
                    >
                        <button
                            class="filter-trigger"
                            type="button"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                        >
                            <span class="filter-label">{{
                                current_board.name
                                    |default('common.unnamed_board'|trans)
                            }}</span>
                            <svg
                                class="filter-chevron"
                                viewBox="0 0 20 20"
                                aria-hidden="true"
                                focusable="false"
                            >
                                <path d="m5 7.5 5 5 5-5" />
                            </svg>
                        </button>
                    </div>
                    <select
                        id="board-switcher-native"
                        class="board-switcher-native"
                        hidden
                    >
                        {% for board in boards %}
                            <option
                                value="{{ board.id }}"
                                data-url="{{ path(
                                    board_route|default('app_board'),
                                    { boardId: board.id }
                                ) }}"
                                {{ board.id == boardId ? 'selected' : '' }}
                            >{{ board.name|default('common.unnamed_board'|trans) }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% else %}
                <strong id="board-name">{{ 'app.title'|trans }}</strong>
            {% endif %}
            <span id="sprint-name" class="board-context"></span>
        </div>
    </div>

    <div class="topbar-create-group">
        <div class="search-field">
            <svg class="ui-icon search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m16.5 16.5 4 4" />
            </svg>
            <input
                id="search"
                type="search"
                placeholder="{{ 'board.search_placeholder'|trans }}"
                aria-label="{{ 'board.search_aria'|trans }}"
            >
        </div>

        <button
            id="create-issue"
            class="create-issue-button"
            type="button"
            aria-haspopup="dialog"
            {% if read_only|default(false) %}hidden{% endif %}
        >
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>{{ 'create.action'|trans }}</span>
        </button>
    </div>

    <div class="topbar-actions">
        <button
            id="reload"
            class="secondary-button reload-button"
            type="button"
            title="{{ 'board.reload'|trans }}"
            aria-label="{{ 'board.reload'|trans }}"
        >
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 11a8 8 0 1 0-2.34 5.66" />
                <path d="M20 4v7h-7" />
            </svg>
        </button>
        <button
            id="theme-toggle"
            class="icon-button theme-toggle-button"
            data-theme-toggle
            data-theme-light-label="{{ 'theme.activate_light'|trans }}"
            data-theme-dark-label="{{ 'theme.activate_dark'|trans }}"
            type="button"
            title="{{ 'theme.change'|trans }}"
            aria-label="{{ 'theme.change'|trans }}"
        >
            <svg
                class="ui-icon theme-icon"
                data-theme-icon="light"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
            </svg>
            <svg
                class="ui-icon theme-icon"
                data-theme-icon="dark"
                viewBox="0 0 24 24"
                aria-hidden="true"
                hidden
            >
                <path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5a8.5 8.5 0 1 0 12 12Z" />
            </svg>
        </button>
    </div>
</header>
