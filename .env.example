APP_ENV=dev
# APP_SECRET is generated in the Symfony vault on the first Docker start.
DEFAULT_URI=http://localhost

# Host allowlist for the local service (DNS-rebinding protection).
TRUSTED_HOSTS=^(localhost|127\.0\.0\.1|\[::1\])$

# Docker only. Interface the container port is published on.
# Keep 127.0.0.1: the application has no authentication, so any other value
# exposes a Jira write API to the local network.
BIND_ADDRESS=127.0.0.1
PORT=5472

JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-your-jira-api-token
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_FALLBACK_STORY_POINTS_FIELD=customfield_10026
